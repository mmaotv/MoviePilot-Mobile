{
  "appId": "com.moviepilot.app",
  "appName": "MoviePilot",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "http",
    "allowNavigation": [
      "*"
    ],
    "cleartext": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0E1116",
      "showSpinner": false,
      "androidSpinnerStyle": "small"
    },
    "StatusBar": {
      "style": "light",
      "backgroundColor": "#0E1116",
      "overlaysWebView": false
    }
  }
}
